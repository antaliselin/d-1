[
	{
		"id": "child",
		"title": "门外的孩子",
		"weight": 1.3,
		"series": true,
		"stages": [
			{
				"speaker": {
					"name": "门外的孩子",
					"title": "瘦得像根柴"
				},
				"lines": [
					"……老板，你在吗？",
					"我两天没吃东西了。我妈妈病着，我不敢空手回去。",
					"给我点吃的，我明天还来。"
				],
				"delivery": {
					"accepts": [
						"food"
					],
					"need": 2
				},
				"choices": [
					{
						"id": "help",
						"label": "给他两件吃的",
						"requiresDelivery": 2,
						"effects": {
							"reputation": 12,
							"reason": "给了门外的孩子吃的"
						},
						"outcome": "他把吃的揣进怀里，跑两步又回头鞠了一躬。"
					},
					{
						"id": "refuse",
						"label": "关上门",
						"ends": true,
						"effects": {
							"reputation": -10,
							"reason": "没管门外的孩子"
						},
						"outcome": "门外安静了很久，才响起拖沓的脚步声。"
					}
				]
			},
			{
				"speaker": {
					"name": "门外的孩子",
					"title": "又来了"
				},
				"lines": [
					"我回来了。",
					"妈妈烧得厉害，我把吃的都给她了。",
					"我不白要——擦货架、搬箱子，我都能干。只要一点药。"
				],
				"delivery": {
					"accepts": [
						"medical"
					],
					"need": 1
				},
				"choices": [
					{
						"id": "help",
						"label": "给他一件药",
						"requiresDelivery": 1,
						"effects": {
							"reputation": 12,
							"reason": "给孩子生病的妈妈送了药"
						},
						"outcome": "他攥着药跑远了，鞋底拍在碎石上的声音很急。"
					},
					{
						"id": "refuse",
						"label": "关上门",
						"ends": true,
						"effects": {
							"reputation": -10,
							"reason": "没管门外的孩子"
						},
						"outcome": "他站了一会儿，慢慢蹲下去，又站起来走了。"
					}
				]
			},
			{
				"speaker": {
					"name": "门外的孩子",
					"title": "妈妈退烧了"
				},
				"lines": [
					"妈妈退烧了。",
					"她让我把这个给你——家里最后一件值钱的东西。",
					"以后我长大了，也来你这儿干活。"
				],
				"choices": [
					{
						"id": "accept",
						"label": "收下礼物",
						"effects": {
							"reputation": 12,
							"reason": "孩子一家记着你",
							"gainItems": [
								{
									"itemId": "goldwatch",
									"count": 1
								}
							]
						},
						"outcome": "金表有点旧，但擦得很亮。你把它收进柜台。"
					},
					{
						"id": "decline",
						"label": "让孩子留着",
						"effects": {
							"reputation": 10,
							"reason": "没收孩子的礼"
						},
						"outcome": "他把金表攥回手心，用力点了点头。"
					}
				]
			}
		]
	},
