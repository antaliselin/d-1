[gd_scene load_steps=2 format=3]

[ext_resource type="Theme" path="res://resources/ui/shop_theme.tres" id="Theme"]

[node name="MapView" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 9
theme = ExtResource("Theme")

[node name="SiteScroll" type="ScrollContainer" parent="."]
layout_mode = 2
custom_minimum_size = Vector2(0, 214)
horizontal_scroll_mode = 0
follow_focus = true

[node name="Sites" type="VBoxContainer" parent="SiteScroll"]
layout_mode = 2
size_flags_horizontal = 3
unique_name_in_owner = true
theme_override_constants/separation = 8

[node name="Details" type="PanelContainer" parent="."]
layout_mode = 2
unique_name_in_owner = true
visible = false
theme_type_variation = &"ShopInset"

[node name="Insets" type="MarginContainer" parent="Details"]
layout_mode = 2
