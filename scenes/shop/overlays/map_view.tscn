[node name="Content" type="VBoxContainer" parent="Details/Insets"]
layout_mode = 2
theme_override_constants/separation = 7

[node name="LocationArt" type="TextureRect" parent="Details/Insets/Content"]
unique_name_in_owner = true
layout_mode = 2
custom_minimum_size = Vector2(0, 128)
expand_mode = 1
stretch_mode = 5
mouse_filter = 2

[node name="LocationName" type="Label" parent="Details/Insets/Content"]
layout_mode = 2
mouse_filter = 2
