[gd_scene load_steps=3 format=3]

[ext_resource type="Theme" path="res://resources/ui/shop_theme.tres" id="Theme"]
[ext_resource type="Script" path="res://scripts/ui/faceted_panel.gd" id="Panel"]

[node name="MapView" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 9
theme = ExtResource("Theme")

[node name="MapFrame" type="PanelContainer" parent="."]
layout_mode = 2
script = ExtResource("Panel")
finish = "wood"

[node name="Insets" type="MarginContainer" parent="MapFrame"]
layout_mode = 2
theme_override_constants/margin_left = 17
theme_override_constants/margin_top = 21
theme_override_constants/margin_right = 17
theme_override_constants/margin_bottom = 21

[node name="Sites" type="GridContainer" parent="MapFrame/Insets"]
layout_mode = 2
unique_name_in_owner = true
columns = 2
theme_override_constants/h_separation = 7
theme_override_constants/v_separation = 10

[node name="Details" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 9
unique_name_in_owner = true
visible = false

[node name="LocationName" type="Label" parent="Details"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 19
text = "工地    风险 15%"
unique_name_in_owner = true
theme_override_colors/font_color = Color(0.96, 0.73, 0.42, 1)

[node name="LocationDescription" type="Label" parent="Details"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 16
text = "脚手架还立着，塔吊停在半空。"
unique_name_in_owner = true
autowrap_mode = 3
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.75, 0.8, 0.73, 1)

[node name="Materials" type="Label" parent="Details"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 15
text = "有机会找到：材料、工具"
unique_name_in_owner = true
autowrap_mode = 3
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.75, 0.8, 0.73, 1)

[node name="Confirm" type="Button" parent="."]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 47)
mouse_default_cursor_shape = 2
theme_type_variation = &"ShopPrimary"
theme_override_font_sizes/font_size = 19
text = "确认搜刮"
unique_name_in_owner = true
disabled = true
