[ext_resource type="Script" path="res://scripts/ui/drop_surface.gd" id="Drop"]

[node name="EventView" type="Control"]
theme = ExtResource("Theme")

[node name="Upper" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_right = 1.0
anchor_bottom = 0.3
offset_bottom = -8.0
theme_override_constants/separation = 6

[node name="EventTitle" type="Label" parent="Upper"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 28
text = "黑鸦帮收租"
