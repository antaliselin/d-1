[gd_scene load_steps=2 format=3]

[ext_resource type="Theme" path="res://resources/ui/shop_theme.tres" id="Theme"]

[node name="ReportView" type="VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 8
theme = ExtResource("Theme")

[node name="ReportTitle" type="Label" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 28
text = "今日打烊"
theme_type_variation = &"ShopTitle"
unique_name_in_owner = true
autowrap_mode = 3
size_flags_horizontal = 3

[node name="Scroll" type="ScrollContainer" parent="."]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ReportText" type="Label" parent="Scroll"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 17
text = "今日进账 0 瓶盖\\n关好卷帘门，明天继续。"
unique_name_in_owner = true
autowrap_mode = 3
size_flags_horizontal = 3

[node name="NextDay" type="Button" parent="."]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 47)
mouse_default_cursor_shape = 2
theme_type_variation = &"ShopPrimary"
theme_override_font_sizes/font_size = 19
text = "进入下一天"
unique_name_in_owner = true
