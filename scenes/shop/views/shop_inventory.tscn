[gd_scene load_steps=8 format=3]

[ext_resource type="Theme" path="res://resources/ui/shop_theme.tres" id="Theme"]
[ext_resource type="Script" path="res://scripts/ui/faceted_panel.gd" id="Panel"]
[ext_resource type="Script" path="res://scripts/ui/stock_drop_scroll.gd" id="StockScroll"]
[ext_resource type="PackedScene" path="res://scenes/ui/stock_row.tscn" id="StockRow"]
[ext_resource type="Texture2D" path="res://assets/items/ammo_shotgun.png" id="PreviewShotgunAmmo"]
[ext_resource type="Texture2D" path="res://assets/items/crowbar.png" id="PreviewCrowbar"]
[ext_resource type="Script" path="res://scripts/ui/shop_symbol.gd" id="Symbol"]

[node name="Inventory" type="PanelContainer"]
layout_mode = 2
theme = ExtResource("Theme")
script = ExtResource("Panel")
finish = "steel"
size_flags_horizontal = 3
custom_minimum_size = Vector2(240, 0)

[node name="Insets" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 14
theme_override_constants/margin_top = 17
theme_override_constants/margin_right = 14
theme_override_constants/margin_bottom = 17

[node name="InventoryContent" type="VBoxContainer" parent="Insets"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="Heading" type="HBoxContainer" parent="Insets/InventoryContent"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="Title" type="Label" parent="Insets/InventoryContent/Heading"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 29
text = "库存"
theme_type_variation = &"ShopTitle"
size_flags_horizontal = 3

[node name="CatalogToggle" type="Button" parent="Insets/InventoryContent/Heading"]
layout_mode = 2
size_flags_horizontal = 8
custom_minimum_size = Vector2(0, 32)
mouse_default_cursor_shape = 2
theme_type_variation = &"ShopQuiet"
theme_override_font_sizes/font_size = 13
text = "全目录"
unique_name_in_owner = true

[node name="InventoryHint" type="Label" parent="Insets/InventoryContent"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 13
text = "按分类查看现有物资"
unique_name_in_owner = true
autowrap_mode = 3
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.75, 0.8, 0.73, 1)

[node name="Filters" type="HBoxContainer" parent="Insets/InventoryContent"]
layout_mode = 2
theme_override_constants/separation = 2

[node name="All" type="Button" parent="Insets/InventoryContent/Filters"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 32)
mouse_default_cursor_shape = 2
theme_type_variation = &"ShopPrimary"
theme_override_font_sizes/font_size = 14
text = "全部"
unique_name_in_owner = true

[node name="Firearms" type="Button" parent="Insets/InventoryContent/Filters"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 32)
mouse_default_cursor_shape = 2
theme_type_variation = &"ShopQuiet"
theme_override_font_sizes/font_size = 14
text = "枪械"
unique_name_in_owner = true

[node name="Ammo" type="Button" parent="Insets/InventoryContent/Filters"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 32)
mouse_default_cursor_shape = 2
theme_type_variation = &"ShopQuiet"
theme_override_font_sizes/font_size = 14
text = "弹药"
unique_name_in_owner = true

[node name="Other" type="Button" parent="Insets/InventoryContent/Filters"]
layout_mode = 2
size_flags_horizontal = 3
custom_minimum_size = Vector2(0, 32)
mouse_default_cursor_shape = 2
theme_type_variation = &"ShopQuiet"
theme_override_font_sizes/font_size = 14
text = "其他"
unique_name_in_owner = true

[node name="StockScroll" type="ScrollContainer" parent="Insets/InventoryContent"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0
unique_name_in_owner = true
vertical_scroll_mode = 2
script = ExtResource("StockScroll")

[node name="ListContent" type="VBoxContainer" parent="Insets/InventoryContent/StockScroll"]
layout_mode = 2
theme_override_constants/separation = 6
size_flags_horizontal = 3

[node name="Rows" type="VBoxContainer" parent="Insets/InventoryContent/StockScroll/ListContent"]
layout_mode = 2
theme_override_constants/separation = 6
unique_name_in_owner = true

[node name="EmptyStock" type="PanelContainer" parent="Insets/InventoryContent/StockScroll/ListContent"]
unique_name_in_owner = true
visible = false
layout_mode = 2
mouse_filter = 2
theme_type_variation = &"ShopInset"
custom_minimum_size = Vector2(0, 151)

[node name="EmptyContent" type="VBoxContainer" parent="Insets/InventoryContent/StockScroll/ListContent/EmptyStock"]
layout_mode = 2
alignment = 1
mouse_filter = 2
theme_override_constants/separation = 7

[node name="Icon" type="Control" parent="Insets/InventoryContent/StockScroll/ListContent/EmptyStock/EmptyContent"]
layout_mode = 2
custom_minimum_size = Vector2(0, 67)
mouse_filter = 2
script = ExtResource("Symbol")
symbol = "empty"

[node name="EmptyMessage" type="Label" parent="Insets/InventoryContent/StockScroll/ListContent/EmptyStock/EmptyContent"]
layout_mode = 2
mouse_filter = 2
theme_override_font_sizes/font_size = 15
text = "当前分类没有现货。"
horizontal_alignment = 1
autowrap_mode = 3
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.75, 0.8, 0.73, 1)

[node name="StockPreview" type="VBoxContainer" parent="Insets/InventoryContent/StockScroll/ListContent"]
layout_mode = 2
theme_override_constants/separation = 6
unique_name_in_owner = true

[node name="PreviewOrder1" parent="Insets/InventoryContent/StockScroll/ListContent/StockPreview" instance=ExtResource("StockRow")]
layout_mode = 2

[node name="PreviewOrder2" parent="Insets/InventoryContent/StockScroll/ListContent/StockPreview" instance=ExtResource("StockRow")]
layout_mode = 2
editor_preview = {"icon": ExtResource("PreviewShotgunAmmo"), "name": "霰弹包", "price": "40", "amount": "80发"}

[node name="PreviewOrder3" parent="Insets/InventoryContent/StockScroll/ListContent/StockPreview" instance=ExtResource("StockRow")]
layout_mode = 2
editor_preview = {"icon": ExtResource("PreviewCrowbar"), "name": "撬棍", "price": "50", "amount": "×1"}
